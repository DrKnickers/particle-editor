{
  "schemaVersion": 1,
  "_readme": [
    "The benchmark's public taxonomy (plan section 3.4, rubric.json). Hashed at lock, checked at run time;",
    "a change is a new hash and a new run. Severity is reported, never used to filter (3.8).",
    "categories: the direction vocabulary and, per direction, the correction options an answer variant may use.",
    "A scalar option's direction is the way the field moves; its accepted interval comes from persisted.mjs.",
    "classes: one row per defect class of plan 3.5, with its stratum; the seed case's category is frozen per corpus."
  ],
  "severities": ["low", "medium", "high"],
  "categories": {
    "missing-texture": {
      "directions": {
        "unresolved": [
          { "kind": "texture", "field": "colorTexture" },
          { "kind": "texture", "field": "normalTexture" }
        ]
      }
    },
    "blend-mode": {
      "directions": {
        "should-be-additive": [{ "kind": "enum", "field": "blendMode", "acceptable": [1, 4] }],
        "should-be-alpha": [{ "kind": "enum", "field": "blendMode", "acceptable": [2, 5, 7] }]
      }
    },
    "flipbook": {
      "directions": {
        "reversed": [{ "kind": "track", "track": 5 }]
      }
    },
    "duration": {
      "directions": {
        "too-short": [
          { "kind": "scalar", "field": "lifetime", "direction": "increase" },
          { "kind": "scalar", "field": "initialDelay", "direction": "decrease" }
        ],
        "too-long": [
          { "kind": "scalar", "field": "lifetime", "direction": "decrease" },
          { "kind": "scalar", "field": "initialDelay", "direction": "increase" }
        ]
      }
    },
    "timing": {
      "directions": {
        "too-late": [
          { "kind": "scalar", "field": "initialDelay", "direction": "decrease" },
          { "kind": "scalar", "field": "lifetime", "direction": "increase" }
        ],
        "too-early": [
          { "kind": "scalar", "field": "initialDelay", "direction": "increase" },
          { "kind": "scalar", "field": "lifetime", "direction": "decrease" }
        ]
      }
    },
    "variation": {
      "directions": {
        "too-much-variation": [
          { "kind": "scalar", "field": "randomLifetimePerc", "direction": "decrease" },
          { "kind": "scalar", "field": "randomScalePerc", "direction": "decrease" },
          { "kind": "scalar", "field": "lifetime", "direction": "decrease" }
        ],
        "too-little-variation": [
          { "kind": "scalar", "field": "randomLifetimePerc", "direction": "increase" },
          { "kind": "scalar", "field": "randomScalePerc", "direction": "increase" }
        ]
      }
    },
    "particle-count": {
      "directions": {
        "too-many": [
          { "kind": "scalar", "field": "nParticlesPerBurst", "direction": "decrease" },
          { "kind": "scalar", "field": "nParticlesPerSecond", "direction": "decrease" }
        ],
        "too-few": [
          { "kind": "scalar", "field": "nParticlesPerBurst", "direction": "increase" },
          { "kind": "scalar", "field": "nParticlesPerSecond", "direction": "increase" }
        ]
      }
    },
    "draw-order": {
      "directions": {
        "wrong-order": [{ "kind": "reorder" }]
      }
    }
  },
  "categoryAliases": {
    "texture": "missing-texture",
    "missing-asset": "missing-texture",
    "blend": "blend-mode",
    "blending": "blend-mode",
    "flipbook-sequence": "flipbook",
    "atlas-sequence": "flipbook",
    "lifetime": "duration",
    "timing-transition": "timing",
    "delay": "timing",
    "randomness": "variation",
    "count": "particle-count",
    "density": "particle-count",
    "sort-order": "draw-order",
    "layering": "draw-order"
  },
  "directionAliases": {
    "too-much-randomness": "too-much-variation",
    "too-little-randomness": "too-little-variation",
    "missing": "unresolved",
    "backwards": "reversed",
    "lingers": "too-long",
    "late": "too-late",
    "early": "too-early"
  },
  "classes": [
    { "id": "missing-texture", "stratum": "objective", "category": "missing-texture", "direction": "unresolved" },
    { "id": "blend-mode", "stratum": "objective", "category": "blend-mode" },
    { "id": "reversed-flipbook", "stratum": "objective", "category": "flipbook", "direction": "reversed" },
    { "id": "short-lifetime", "stratum": "subjective", "category": "duration", "direction": "too-short" },
    { "id": "late-delay", "stratum": "subjective", "category": "timing", "direction": "too-late" },
    { "id": "random-lifetime", "stratum": "subjective", "category": "variation", "direction": "too-much-variation" },
    { "id": "random-scale", "stratum": "subjective", "category": "variation", "direction": "too-much-variation" },
    { "id": "lingering-trail", "stratum": "subjective", "category": "duration", "direction": "too-long" },
    { "id": "draw-order", "stratum": "objective", "category": "draw-order", "direction": "wrong-order" },
    { "id": "particle-count", "stratum": "objective", "category": "particle-count", "direction": "too-many" },
    { "id": "child-timing", "stratum": "subjective", "category": "timing", "direction": "too-late" },
    { "id": "seed", "stratum": "subjective", "optional": true }
  ],
  "limits": {
    "fileBytes": 8388608,
    "findings": 256,
    "trackKeysPerFinding": 65536,
    "trackKeysTotal": 262144,
    "citationsTotal": 4096,
    "stringLength": 4096
  }
}
