/////////////////////////////////////////////////////////////////////////////
// Neutral resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_NEU)
#ifdef _WIN32
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
#pragma code_page(1252)
#endif //_WIN32

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//
// IDB_MISSING is the placeholder texture the shared TextureManager
// (src/main.cpp) hands back when a particle's texture file can't be loaded —
// live code, not legacy UI, so it stays.

IDB_MISSING             BITMAP                  "resources/missing.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// IDI_LOGO is the application icon (loaded by the host window class,
// src/host/HostWindow.cpp). The legacy curve-editor icons were removed with
// the native UI ().
IDI_LOGO                ICON                    "resources/logo.ico"

/////////////////////////////////////////////////////////////////////////////
//
// RCDATA
//

IDS_SCENEHEAT           RCDATA                  "Resources\\SceneHeat.fx"
IDR_DEFAULT_SHADER      RCDATA                  "resources\\DefaultShader.fx"
IDR_SHADER_SKYDOME      RCDATA                  "Resources\\Engine\\Skydome.fx"
IDR_SHADER_GROUND_LIT   RCDATA                  "Resources\\Engine\\GroundLit.fx"

// ground textures. Declared RCDATA (not BITMAP) so the source
// file format isn't restricted to .bmp — D3DXCreateTextureFromFileInMemory
// in engine.cpp sniffs the actual bytes and handles BMP / DDS / TGA /
// PNG / JPG / HDR identically.
//
// Grass / Sand / Snow are vanilla EaW textures bundled by permission.
// Slot 4 ("Solid Color") is procedurally generated from a user-picked
// COLORREF — no resource needed.
IDB_GROUND              RCDATA                  "Resources\\dirt.bmp"
IDB_GROUND_GRASS        RCDATA                  "Resources\\grass.dds"
IDB_GROUND_SAND         RCDATA                  "Resources\\sand.dds"
IDB_GROUND_SNOW         RCDATA                  "Resources\\snow.dds"

// skydome textures. Declared RCDATA so D3DXCreateTextureFromFileInMemory
// can load them. Procedural-gradient TGA placeholders today; a follow-up
// PR can replace with curated equirectangular DDS (BC1) assets without
// touching the loader.
IDR_SKYDOME_SPACE       RCDATA                  "Resources\\skydomes\\space.tga"
IDR_SKYDOME_ATMOSPHERE  RCDATA                  "Resources\\skydomes\\atmosphere.tga"
IDR_SKYDOME_SUNSET      RCDATA                  "Resources\\skydomes\\sunset.tga"
IDR_SKYDOME_DAWN        RCDATA                  "Resources\\skydomes\\dawn.tga"
IDR_SKYDOME_NIGHT       RCDATA                  "Resources\\skydomes\\night.tga"
IDR_SKYDOME_OVERCAST    RCDATA                  "Resources\\skydomes\\overcast.tga"
IDR_SKYDOME_STUDIO      RCDATA                  "Resources\\skydomes\\studio.tga"
IDR_SKYDOME_INDOOR      RCDATA                  "Resources\\skydomes\\indoor.tga"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PE_VERSION_MAJOR,PE_VERSION_MINOR,PE_VERSION_PATCH,0
 PRODUCTVERSION PE_VERSION_MAJOR,PE_VERSION_MINOR,PE_VERSION_PATCH,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x5L
#else
 FILEFLAGS 0x4L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "Mike Lankamp"
            VALUE "FileDescription", "Particle Editor"
            VALUE "FileVersion", PE_VERSION_STR
            VALUE "InternalName", "Particle Editor"
            VALUE "LegalCopyright", "Copyright (C) 2009 Mike Lankamp"
            VALUE "OriginalFilename", "ParticleEditor.exe"
            VALUE "ProductName", "Particle Editor"
            VALUE "ProductVersion", PE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//
//: the shared error/query strings the surviving engine/IO/host code
// LoadString()s, migrated here (LANG_NEUTRAL, so they resolve under any
// system locale) from the now-deleted ParticleEditor.en.rc when the legacy
// localized .rc/.h files were removed. Ids are defined in Resources\resource.h.
//

STRINGTABLE
BEGIN
    IDS_ERROR_FILE_READ         "Unable to read file"
    IDS_ERROR_FILE_FIND         "Unable to find file:\n%ls"
    IDS_ERROR_FILE_WRITE        "Unable to write file"
    IDS_ERROR_FILE_CORRUPT      "Bad or corrupted file"
    IDS_ERROR_FILE_FORMAT       "The file is not a particle file"
    IDS_ERROR_XML_PARSER_CREATE "Unable to create XML parser"
    IDS_ERROR_XML               "%ls at line %d"
    IDS_QUERY_DATA_PATH         "Please select the Star Wars Empire at War or Forces of Corruption folder that contains the Data folder."
    IDS_ERROR_FILE_OPEN         "Unable to open file:\n%ls"
    IDS_ERROR_FILE_CREATE       "Unable to create file:\n%ls"
    IDS_ERROR_RENDERER_RESET    "Unable to reset rendering window"
END

#endif    // Neutral resources
